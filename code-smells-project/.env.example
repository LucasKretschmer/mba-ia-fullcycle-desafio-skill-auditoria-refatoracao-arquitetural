# Copie para o ambiente (export) e ajuste os valores.
SECRET_KEY=
DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
CORS_ORIGINS=http://localhost:3000
# Token exigido no header X-Admin-Token para /admin/*; vazio desabilita esses endpoints.
ADMIN_TOKEN=
# Senha do admin@loja.com criado no seed inicial; vazio gera uma senha aleatória.
SEED_ADMIN_SENHA=
APP_ENV=desenvolvimento
LOG_LEVEL=INFO
